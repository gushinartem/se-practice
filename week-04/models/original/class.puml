@startuml
hide empty members
skinparam classAttributeIconSize 0

enum BookingStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

class Student {
  - studentId : String
  - name : String
  + reserveRoom(room : Room, start : DateTime, end : DateTime) : Booking
  + cancelBooking(booking : Booking) : void
}

class Room {
  - roomId : String
  - name : String
  - blocked : Boolean
  + block() : void
  + unblock() : void
  + isAvailable(start : DateTime, end : DateTime) : Boolean
}

class Booking {
  - bookingId : String
  - startTime : DateTime
  - endTime : DateTime
  - status : BookingStatus
  / duration : Duration
  + overlapsWith(other : Booking) : Boolean
  + isActive() : Boolean
  + cancel() : void
}

class Confirmation {
  - confirmationId : String
  - issuedAt : DateTime
}

Student "1" -- "0..*" Booking : makes >
Room "1" -- "0..*" Booking : is reserved by >
Booking "1" -- "1" Confirmation : produces >
Booking ..> BookingStatus
@enduml