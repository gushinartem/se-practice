@startuml
hide empty members
skinparam classAttributeIconSize 0

enum BookingStatus {
  ACTIVE
  CANCELLED
}

class Student {
  - studentId : String
  - name : String
}

class Room {
  - roomId : String
  - name : String
  - blocked : Boolean
  + block() : void
  + unblock() : void
  + isAvailable(start : DateTime, end : DateTime) : Boolean
}

class Booking {
  - bookingId : String
  - startTime : DateTime
  - endTime : DateTime
  - status : BookingStatus
  / duration : Duration
  + overlapsWith(other : Booking) : Boolean
  + isActive() : Boolean
  + cancel() : void
}

class Confirmation {
  - confirmationId : String
  - issuedAt : DateTime
}

Student "1" -- "0..*" Booking : makes >
Room "1" -- "0..*" Booking : is reserved by >
Booking "1" -- "1" Confirmation : produces >

note right of Booking
  R1: start in the future; 0 < duration <= 2h.
  R2: active bookings of the same room
  must not overlap (touching is allowed, A1).
  R4: only a successful booking has a Confirmation.
end note

note left of Room
  R3: a blocked room accepts no new booking.
  A2: existing bookings stay valid.
end note
@enduml
